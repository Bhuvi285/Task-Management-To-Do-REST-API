# Copy to .env and replace every REPLACE_* value with deployment-specific values.
POSTGRES_DB=taskmanager
DATABASE_USERNAME=taskmanager
DATABASE_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_RANDOM_KEY_OF_AT_LEAST_32_BYTES
JWT_ISSUER=task-management-api
JWT_ACCESS_TOKEN_EXPIRATION=PT15M
JWT_REFRESH_TOKEN_EXPIRATION=P30D
CORS_ALLOWED_ORIGINS=https://app.example.test
API_DOCS_ENABLED=false
SERVER_PORT=8080

GOOGLE_OAUTH2_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.test/login/oauth2/code/google
GITHUB_OAUTH2_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://api.example.test/login/oauth2/code/github

PASSWORD_RESET_EMAIL_ENABLED=true
PASSWORD_RESET_EMAIL_FROM=no-reply@example.test
PASSWORD_RESET_RESET_URL=https://app.example.test/reset-password
SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD

DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000
DB_POOL_VALIDATION_TIMEOUT_MS=5000
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=PT1M
LOGIN_RATE_LIMIT_MAX_KEYS=10000
PASSWORD_RESET_IP_LIMIT=10
PASSWORD_RESET_ACCOUNT_LIMIT=3
PASSWORD_RESET_RATE_WINDOW=PT1H
PASSWORD_RESET_RATE_LIMIT_MAX_KEYS=10000
PASSWORD_RESET_COOLDOWN=PT1M
PASSWORD_RESET_TOKEN_EXPIRATION=PT15M
